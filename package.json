{
  "name": "@dice-roller/vue",
  "version": "1.3.3",
  "description": "Vue.js component which allows rolling dice",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/vue.umd.cjs",
  "module": "./dist/vue.js",
  "unpkg": "./dist/vue.umd.cjs",
  "exports": {
    ".": {
      "import": "./dist/vue.js",
      "require": "./dist/vue.umd.cjs"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "lint": "eslint . --max-warnings=0",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node --test tests/*.test.js",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dice-roller/vue.git"
  },
  "keywords": [
    "dice",
    "roll",
    "vue"
  ],
  "author": "GreenImp Media <info@greenimp.co.uk> (https://greenimp.co.uk)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dice-roller/vue/issues"
  },
  "homepage": "https://github.com/dice-roller/vue",
  "dependencies": {
    "@dice-roller/rpg-dice-roller": "^5.5.0",
    "@heroicons/vue": "^2.2.0",
    "@vueuse/core": "^15.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.7",
    "vue": "^3.5.45",
    "vue-eslint-parser": "^10.4.2"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "overrides": {
    "eslint": {
      "minimatch": "^11.0.5"
    }
  }
}
